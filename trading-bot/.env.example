# Copy to .env and fill in. Get keys at https://app.alpaca.markets (Paper and Live have different keys).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Leave true until you've watched it trade on paper. Set to false for real money.
ALPACA_PAPER=true
# Optional, e.g. http://homeassistant.local:8123/api/webhook/trading_bot
NOTIFY_WEBHOOK_URL=
